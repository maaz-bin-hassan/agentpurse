# Demo default. Everything below runs with these two lines and no accounts.
PAYPAL_MODE=mock
AI_MODE=mock

# SQLite file. Leave unset to use data/agentpurse.db.
# AGENTPURSE_DB=data/agentpurse.db

# Postgres (Supabase). When set, this replaces SQLite.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Set to 0 to start from an empty database instead of Maya's household.
# AGENTPURSE_AUTO_SEED=1

# Used only when PAYPAL_MODE=live (sandbox).
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_WEBHOOK_ID=
# PAYPAL_MERCHANT_EMAIL=sb-merchant@business.example.com

# Used only when AI_MODE=live. Provider is groq or gemini.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GEMINI_API_KEY=
# AI_MODEL=

# Public URL of this app. Required for OAuth metadata and PayPal return URLs.
# PUBLIC_BASE_URL=http://localhost:3000

# WebAuthn. Use the hostname only for RP ID.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000

# Web Push. Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Stdio MCP and Claude Desktop.
# AGENTPURSE_API_KEY=agpk_grocer_demo_maya
